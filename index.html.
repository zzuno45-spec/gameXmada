<script>


/* RECHERCHE */

function searchGame(){

    let input =
    document
    .getElementById("searchInput")
    .value
    .toLowerCase();


    let games =
    document
    .querySelectorAll(".game-card");


    games.forEach(function(game){

        let name =
        game
        .querySelector("h3")
        .innerText
        .toLowerCase();


        if(name.includes(input)){

            game.style.display =
            "block";

        }else{

            game.style.display =
            "none";

        }

    });

}



